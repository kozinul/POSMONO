# Variabel untuk docker/docker-compose.caddy.yml DAN docker/docker-compose.prod.yml.
# Salin jadi docker/.env (gitignored) lalu isi sesuai kebutuhan.
#
# File ini WAJIB ada sebelum `docker compose ... up`: compose membaca kredensial Mongo
# dan domain TLS dari sini, bukan dari backend/.env.

# Domain publik (tanpa protokol, tanpa sub-path). Contoh: pos.domain.id
DOMAIN=pos.example.com

# Email kontak Let's Encrypt (opsional, tapi disarankan). Biarkan default bila
# tidak ingin mendapat notifikasi kedaluwarsa sertifikat.
ACME_EMAIL=admin@example.com

# --- MongoDB (wajib) ---
# Menyetel KEDUA variabel ini membuat container `mongodb` otomatis jalan dengan `--auth`
# dan membuat user root ini pada boot pertama (volume kosong). docker/docker-compose.prod.yml
# sengaja gagal start bila keduanya kosong — tanpa auth, database terbuka bagi apa pun
# yang bisa menjangkau network `kuire`.
#
# PENTING: password juga dirangkai ke dalam MONGO_URI, jadi pakai karakter aman-URL
# (huruf, angka, `-`, `_`). Hindari `@ : / # ? & %` yang akan merusak URI.
MONGO_INITDB_ROOT_USERNAME=posmono
MONGO_INITDB_ROOT_PASSWORD=change-me-to-a-long-random-password

# Nama database aplikasi (dipakai untuk merangkai MONGO_URI di service `app`).
MONGO_DATABASE=posmono

# --- User aplikasi (wajib, least-privilege) ---
# Dibuat otomatis SEKALI oleh docker/mongo-init/10-app-user.js saat volume `mongodb_data`
# masih kosong. Role-nya hanya `readWrite` pada MONGO_DATABASE — service `app` memakai
# kredensial ini, bukan root. Root di atas tetap dipakai untuk admin/backup.
# WAJIB berbeda dari MONGO_INITDB_ROOT_USERNAME; password juga dirangkai ke MONGO_URI
# sehingga harus aman-URL (huruf, angka, `-`, `_`).
MONGO_APP_USERNAME=posmono_app
MONGO_APP_PASSWORD=change-me-to-another-long-random-password

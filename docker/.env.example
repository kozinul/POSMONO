# Variabel untuk docker/docker-compose.caddy.yml
# Salin jadi docker/.env (gitignored) lalu isi sesuai kebutuhan.

# Domain publik (tanpa protokol, tanpa sub-path). Contoh: pos.domain.id
DOMAIN=pos.example.com

# Email kontak Let's Encrypt (opsional, tapi disarankan). Biarkan default bila
# tidak ingin mendapat notifikasi kedaluwarsa sertifikat.
ACME_EMAIL=admin@example.com

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-internal"],
  "workspaces": {
    "backend": {
      "entry": [
        "src/dev.ts",
        "src/bootstrap/app.ts",
        "src/scripts/**/*.ts",
        "tests/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.ts", "tests/**/*.{ts,tsx}"],
      "ignoreDependencies": ["pino-pretty"],
      "ignoreBinaries": ["ts-node", "k6"]
    },
    "frontend": {
      "entry": ["tests/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "shared": {
      "project": ["src/**/*.ts"]
    }
  }
}

NODE_ENV=production
PORT=3000
# NOTE: in production, `docker/docker-compose.prod.yml` OVERRIDES MONGO_URI (via the
# `app` service `environment`) with a URI built from docker/.env using the scoped app
# user + `?authSource=admin`, so the database password lives in exactly one file. This
# value is what the app/seed scripts use when run outside that compose stack (dev,
# host-side scripts).
MONGO_URI=mongodb://mongodb:27017/posmono
REDIS_URL=redis://redis:6379

# PLACEHOLDER — development only. `bootstrap/app.ts` refuses to boot with this value (or
# any other .env.example example) in NODE_ENV=production. Generate one: `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Only read by `node backend/dist/seed.js --prod` (never by the app runtime) ---
# ADMIN_EMAIL=owner@domain.id
# ADMIN_PASSWORD=pick-a-strong-password
# PLATFORM_ADMIN_EMAIL=platform@domain.id   # optional: Terminal Center account
# PLATFORM_ADMIN_PASSWORD=pick-a-strong-password
# TENANT_NAME=Nama Toko                     # optional
# TENANT_SLUG=nama-toko                     # optional (used for the idempotent check)

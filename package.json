{
  "name": "kuire-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Kuire — Modular SaaS Platform",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@posmono/backend",
    "dev:web": "turbo run dev --filter=@posmono/frontend",
    "build": "turbo run build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "budget": "node scripts/complexity-budget.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean",
    "reset": "pnpm run clean && rm -rf node_modules && pnpm install",
    "prepare": "husky",
    "db:seed": "turbo run seed --filter=@posmono/backend",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
